# This repo must never contain RØDE firmware (stock or patched), RØDE software, or USB captures.
# Users build images locally from their own RØDE Central install (see firmware/README.md).
*.bin
*.hex
*.dll
*.exe
*.msi
*.pkg
*.apk
*.xapk
*.pcap
*.pcapng
*.log
*.wav

__pycache__/
*.pyc
/build/
/dist/
/out/
*.spec
# written by the CI build from the git tag
wizard/_version.py

# docker/ build inputs and run-time secrets
ghidra*.zip
.env
